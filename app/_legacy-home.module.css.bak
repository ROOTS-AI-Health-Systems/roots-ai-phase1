/* app/page.module.css */
.main {
  background-color: var(--background);
}

.sectionContainer {
  max-width: 1440px;
  margin: 0 auto;
  padding: 0 16px;
}

@media (min-width: 768px) {
  .sectionContainer {
    padding: 0 24px;
  }
}

@media (min-width: 1024px) {
  .sectionContainer {
    padding: 0 40px;
  }
}

.sectionTitle {
  font-size: 28px;
  font-weight: 700;
  color: var(--primary);
  text-align: center;
  margin-bottom: 16px;
}

@media (min-width: 768px) {
  .sectionTitle {
    font-size: 34px;
  }
}

.sectionSubtitle {
  font-size: 16px;
  color: var(--gray);
  text-align: center;
  margin-bottom: 32px;
}

/* Hero */
.hero {
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  padding: 48px 16px 56px;
  margin-top: 0;
}

@media (min-width: 768px) {
  .hero {
    padding: 72px 24px 80px;
  }
}

@media (min-width: 1024px) {
  .hero {
    padding: 80px 40px 96px;
  }
}

.heroInner {
  max-width: 1024px;
  margin: 0 auto;
  text-align: center;
}

.heroTitle {
  font-size: 28px;
  font-weight: 700;
  color: var(--white);
  line-height: 1.2;
  margin-bottom: 24px;
}

@media (min-width: 768px) {
  .heroTitle {
    font-size: 34px;
  }
}

@media (min-width: 1024px) {
  .heroTitle {
    font-size: 48px;
  }
}

.heroSubtitle {
  font-size: 16px;
  color: var(--white);
  line-height: 1.6;
  margin-bottom: 32px;
}

.heroButtons {
  display: flex;
  flex-direction: column;
  gap: 12px;
  align-items: center;
}

@media (min-width: 640px) {
  .heroButtons {
    flex-direction: row;
    justify-content: center;
  }
}

.btnPrimary {
  display: inline-block;
  padding: 12px 32px;
  background: var(--primary);
  color: var(--white);
  border-radius: 8px;
  font-size: 16px;
  font-weight: 600;
  transition: opacity 0.2s;
  text-align: center;
  min-width: 200px;
}

.btnPrimary:hover {
  opacity: 0.9;
}

.btnSecondary {
  display: inline-block;
  padding: 12px 32px;
  background: transparent;
  color: var(--white);
  border-radius: 8px;
  font-size: 16px;
  font-weight: 600;
  border: 2px solid var(--white);
  transition: background 0.2s;
  text-align: center;
  min-width: 200px;
}

.btnSecondary:hover {
  background: rgba(255,255,255,0.1);
}

/* Trust */
.trust {
  background: var(--gray-light);
  padding: 16px 0;
}

.trustInner {
  max-width: 1440px;
  margin: 0 auto;
  padding: 0 16px;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 16px 32px;
}

@media (min-width: 768px) {
  .trustInner {
    padding: 0 24px;
    flex-wrap: nowrap;
  }
}

.trustInner span {
  font-size: 14px;
  font-weight: 500;
  color: var(--primary);
  text-align: center;
}

/* Features */
.features {
  padding: 48px 0;
}

.featureList {
  display: flex;
  flex-direction: column;
  gap: 12px;
  max-width: 1024px;
  margin: 0 auto;
}

.featureItem {
  padding: 16px 24px;
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: 12px;
  text-align: center;
}

.featureItem p {
  font-size: 16px;
  font-weight: 600;
  color: var(--primary);
}

/* Domains */
.domains {
  padding: 48px 0;
  background: var(--white);
}

.domainGrid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 16px;
  max-width: 1024px;
  margin: 0 auto;
}

@media (min-width: 640px) {
  .domainGrid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (min-width: 1024px) {
  .domainGrid {
    grid-template-columns: repeat(3, 1fr);
  }
}

.domainCard {
  padding: 20px;
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: 12px;
  text-align: center;
}

.domainCard h3 {
  font-size: 16px;
  font-weight: 600;
  color: var(--primary);
  margin-bottom: 8px;
}

.domainCard p {
  font-size: 16px;
  color: var(--gray);
  line-height: 1.5;
}

/* How It Works */
.howItWorks {
  padding: 48px 0;
}

.stepGrid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 16px;
  max-width: 1024px;
  margin: 0 auto;
}

@media (min-width: 640px) {
  .stepGrid {
    grid-template-columns: repeat(2, 1fr);
  }
}

.stepCard {
  padding: 24px 20px;
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: 12px;
}

.stepNumber {
  display: inline-block;
  font-size: 20px;
  font-weight: 700;
  color: var(--primary);
  margin-bottom: 8px;
}

@media (min-width: 768px) {
  .stepNumber {
    font-size: 22px;
  }
}

@media (min-width: 1024px) {
  .stepNumber {
    font-size: 24px;
  }
}

.stepCard h3 {
  font-size: 16px;
  font-weight: 600;
  color: var(--primary);
  margin-bottom: 8px;
}

.stepCard p {
  font-size: 16px;
  color: var(--gray);
  line-height: 1.5;
}

/* Example Report */
.exampleReport {
  padding: 48px 0;
  background: var(--white);
}

.reportPreview {
  max-width: 1024px;
  margin: 0 auto;
  padding: 32px 24px;
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: 12px;
  text-align: center;
}

.reportPreview h3 {
  font-size: 16px;
  font-weight: 600;
  color: var(--primary);
  margin-bottom: 16px;
}

.reportPreview p {
  font-size: 16px;
  color: var(--gray);
  margin-bottom: 8px;
}

.previewDisclaimer {
  font-style: italic;
  font-size: 16px !important;
  color: var(--gray) !important;
}

.reportPreview .btnPrimary {
  margin-top: 16px;
}

/* Beta */
.beta {
  padding: 48px 0;
  background: var(--gray-light);
  text-align: center;
}

.beta .sectionSubtitle {
  margin-bottom: 24px;
}

.beta .btnPrimary {
  background: var(--primary);
  color: var(--white);
}